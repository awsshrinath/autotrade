{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "8.5.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Scaling CronJob Status (Last 24h)",
      "type": "stat",
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(kube_job_status_succeeded{job_name=~\"market-.*-scaler.*\"}) by (job_name)",
          "legendFormat": "{{job_name}} Success",
          "instant": true
        },
        {
          "expr": "sum(kube_job_status_failed{job_name=~\"market-.*-scaler.*\"}) by (job_name)",
          "legendFormat": "{{job_name}} Failed",
          "instant": true
        }
      ]
    },
    {
      "title": "Deployment Replica Counts",
      "type": "timeseries",
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "kube_deployment_spec_replicas{deployment=~\"stock-trader|options-trader|futures-trader|cognitive-system\"}",
          "legendFormat": "{{deployment}}"
        }
      ]
    },
    {
      "title": "Support Pod Replica Counts",
      "type": "timeseries",
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "kube_deployment_spec_replicas{deployment=~\"main-runner|dashboard|monitoring-service\"}",
          "legendFormat": "{{deployment}}"
        }
      ]
    },
    {
      "title": "Cluster Node Count",
      "type": "timeseries",
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "count(kube_node_info)",
          "legendFormat": "Node Count"
        }
      ]
    }
  ],
  "schemaVersion": 35,
  "style": "dark",
  "tags": ["scaling", "trading-system"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Market Hours Scaling Dashboard",
  "version": 1
} 