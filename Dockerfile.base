# TRON Trading System - Optimized Base Image
# This image contains all dependencies but NO source code
# Source code will be mounted as volumes for zero-rebuild deployments

# Stage 1: Builder stage for dependencies
FROM python:3.10-slim as builder

WORKDIR /build

# Install build dependencies for Debian
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    build-essential \
    libffi-dev \
    libssl-dev \
    && pip install --no-cache-dir pip-tools \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and compile/install Python packages
COPY requirements.in .

# Set PATH for pip user installations during build
ENV PATH="/root/.local/bin:$PATH"

# Install PyTorch CPU version first (smaller and more compatible)
RUN pip install --no-cache-dir --user --no-warn-script-location torch --index-url https://download.pytorch.org/whl/cpu

# Compile and install remaining requirements
RUN pip-compile requirements.in --output-file=requirements.txt --pip-args "--timeout=60"
RUN pip install --no-cache-dir --user --no-warn-script-location -r requirements.txt

# Stage 2: Runtime image
FROM python:3.10-slim

LABEL maintainer="TRON Trading System"
LABEL description="Base image for TRON trading services with all dependencies"
LABEL version="1.0"

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -g 1001 tron && \
    useradd -u 1001 -g tron -d /app -s /bin/bash tron

# Set up directory structure
WORKDIR /app
RUN mkdir -p /app/logs /app/data /app/config && \
    chown -R tron:tron /app

# Copy installed Python packages from builder
COPY --from=builder --chown=tron:tron /root/.local /home/tron/.local

# Set up environment
ENV PATH="/home/tron/.local/bin:$PATH"
ENV PYTHONPATH="/app"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TZ=UTC

# Create __init__.py files for Python module structure
RUN mkdir -p /app/runner /app/gpt_runner /app/dashboard_api /app/stock_trading \
    /app/options_trading /app/futures_trading /app/strategies /app/utils \
    /app/services /app/config /app/mcp && \
    touch /app/__init__.py /app/runner/__init__.py /app/gpt_runner/__init__.py \
    /app/dashboard_api/__init__.py /app/stock_trading/__init__.py \
    /app/options_trading/__init__.py /app/futures_trading/__init__.py \
    /app/strategies/__init__.py /app/utils/__init__.py /app/services/__init__.py \
    /app/config/__init__.py /app/mcp/__init__.py && \
    chown -R tron:tron /app

# Switch to non-root user
USER tron

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Default command (will be overridden by docker-compose)
CMD ["python", "--version"]