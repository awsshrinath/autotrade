# TRON Trading System - Docker Environment Configuration
# Single Instance Deployment Settings

# Environment Configuration
ENVIRONMENT=production
PAPER_TRADE=true
LOG_LEVEL=INFO

# Google Cloud Platform Settings
GCP_PROJECT_ID=autotrade-453303
GOOGLE_APPLICATION_CREDENTIALS=/app/gpt-runner-sa-key.json

# Trading Configuration
DEFAULT_CAPITAL=100000
MAX_DAILY_LOSS=1000
MAX_DAILY_LOSS_PCT=2.0

# Service Ports (for internal Docker networking)
MAIN_RUNNER_PORT=8080
STOCK_TRADER_PORT=8081
OPTIONS_TRADER_PORT=8082
FUTURES_TRADER_PORT=8083
DASHBOARD_API_PORT=8090
FRONTEND_PORT=3000
LOG_AGGREGATOR_PORT=8095

# Health Check Settings
HEALTH_CHECK_ENABLED=false
HEALTH_CHECK_INTERVAL=30

# Service Discovery (Docker internal hostnames)
DASHBOARD_API_HOST=dashboard-api
MAIN_RUNNER_HOST=main-runner
STOCK_TRADER_HOST=stock-trader
OPTIONS_TRADER_HOST=options-trader
FUTURES_TRADER_HOST=futures-trader
LOG_AGGREGATOR_HOST=log-aggregator

# External URLs for frontend
NEXT_PUBLIC_API_URL=http://localhost:8090

# Logging Configuration
LOG_DIRECTORY=/app/logs
LOG_RETENTION_DAYS=30

# Database and External Services
FIRESTORE_ENABLED=true
SECRET_MANAGER_ENABLED=true

# CORS Settings for API
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# API Rate Limiting
API_RATE_LIMIT=3
API_TIMEOUT=10

# Position Limits (as percentage of capital)
STOCK_POSITION_LIMIT=0.10
OPTION_POSITION_LIMIT=0.05
FUTURE_POSITION_LIMIT=0.15

# Risk Management
MARGIN_UTILIZATION_LIMIT=0.80
MAX_VOLATILITY_THRESHOLD=0.05
MIN_TRADE_VALUE=1000

# Auto square-off time
AUTO_SQUARE_OFF_TIME=15:20

# Monitoring Settings
MONITORING_INTERVAL=30
BACKUP_FREQUENCY=300

# Alert Settings (disabled by default for single instance)
ALERTS_EMAIL_ENABLED=false
ALERTS_SLACK_ENABLED=false
ALERTS_WEBHOOK_URL=

# Development vs Production
NODE_ENV=production
PYTHONPATH=/app:/app/runner:/app/gpt_runner:/app/runner/utils:/app/runner/enhanced_logging

# Scalping Strategy Configuration
SCALP_MIN_PRICE=100
SCALP_MAX_PRICE=120
SCALP_SL_BUFFER=30
SCALP_TARGET_BUFFER=60
SCALP_QUANTITY=75

# Technical Indicators
RSI_PERIOD=14
ATR_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BOLLINGER_PERIOD=20
BOLLINGER_STD=2.0

# Options Configuration
RISK_FREE_RATE=0.06
DEFAULT_IV=0.20
MAX_IV=5.0
MIN_IV=0.01

# Portfolio Settings
MAX_POSITIONS=10
CORRELATION_LIMIT=0.7
DIVERSIFICATION_THRESHOLD=0.3