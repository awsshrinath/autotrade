# Dashboard API Environment Configuration Example
# Copy this file to .env and customize for your environment

# === Security Configuration ===

# JWT Authentication (Default: disabled for backward compatibility)
# Set to "true", "1", "yes", or "on" to enable JWT authentication
ENABLE_JWT_AUTH=false

# JWT Secret Key (IMPORTANT: Change this in production!)
# Generate a secure random secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=tron-dashboard-secret-key-change-in-production

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === API Configuration ===

# Environment
ENVIRONMENT=development

# Rate Limiting Configuration
ENABLE_RATE_LIMITING=false
RATE_LIMIT_PER_MINUTE=1000
API_RATE_LIMIT_PER_MINUTE=500
AUTH_RATE_LIMIT_PER_MINUTE=10
LOGS_RATE_LIMIT_PER_MINUTE=100
COGNITIVE_RATE_LIMIT_PER_MINUTE=50

# Redis for distributed rate limiting (optional)
REDIS_URL=redis://localhost:6379/0

# === External Services ===

# OpenAI API for cognitive services
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Platform
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name

# === Database ===

# Firestore
FIRESTORE_COLLECTION=trading_logs

# === Kubernetes ===

# K8s Configuration
K8S_NAMESPACE=default
K8S_CONFIG_PATH=~/.kube/config

# === Logging ===

# Log Level
LOG_LEVEL=INFO

# === Demo Users (for testing) ===
# Default users available for testing:
# Username: testuser, Password: testpassword
# Username: admin, Password: admin123 